# PostgreSQL connection string (Railway provisions this automatically when a
# Postgres service is attached — copy it from that service's "Connect" tab).
DATABASE_URL="postgresql://user:password@host:port/database"

# Random secret used to sign NextAuth session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public URL of this deployment (used by NextAuth for callbacks/redirects).
NEXTAUTH_URL="https://your-app.up.railway.app"
